# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Formspree. El formulario ya trae su ID en src/pages/index.astro, así que
# esta variable es opcional: sólo hace falta para apuntar a OTRO formulario
# (por ejemplo uno de pruebas) sin tocar el código.
# Acepta el ID suelto o la URL completa; una dirección de correo NO es válida.
# VITE_FORMSPREE_ENDPOINT=xrgvabcd
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xrgvabcd

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# Deployment URLs
# VITE_SITE_URL=https://mrezk84.github.io/presentacion_page
# VITE_API_URL=https://api.example.com
