# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Formspree for contact form.
# Use the FORM ID from your Formspree dashboard (the part after /f/), or the
# full endpoint URL — an email address here is NOT valid and produces a
# broken endpoint. If this is unset the form falls back to a mailto: link.
# VITE_FORMSPREE_ENDPOINT=xrgvabcd
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xrgvabcd

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# Deployment URLs
# VITE_SITE_URL=https://mrezk84.github.io/presentacion_page
# VITE_API_URL=https://api.example.com
