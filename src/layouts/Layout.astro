---
// Tipografía self-hosted. Antes venía de fonts.googleapis.com, lo que costaba
// dos DNS + dos handshakes TLS a terceros en el camino crítico, y le pasaba la
// IP de cada visitante a Google. Ahora sale del mismo origen.
//
// Sólo el subset `latin` y sólo el eje de peso: `latin` ya cubre el español y
// el signo menos de "UTC−3"; el archivo con todos los ejes de Bricolage pesa
// 56 KB contra 20 KB del de peso, y los ejes opsz/wdth no compensan esa
// diferencia. Las variables cubren 400–700 en un archivo por familia.
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Marcos Rezk | Full Stack Developer",
	description = "Full Stack Developer con experiencia en React, C# .NET, SQL Server y más. Egresado de ORT Uruguay. Especialista en desarrollo de aplicaciones web escalables.",
	image = "/perfil.jpg"
} = Astro.props;

const isVercel = import.meta.env.VERCEL === '1';
const isDevelopment = import.meta.env.DEV;

const basePath = isVercel || isDevelopment ? '' : '/presentacion_page';

const assetUrl = (path: string) => `${basePath}${path}`;

const faviconURL = assetUrl('/favicon.svg');

// Absolute URLs for JSON-LD and social cards.
const baseURL = isVercel
  ? 'https://presentacion-page.vercel.app'
  : 'https://mrezk84.github.io/presentacion_page';

const baseURLClean = baseURL.replace(/\/$/, '');
const imagePath = image.replace(/^\//, '');

const fullImageURL = `${baseURLClean}/${imagePath}`;
const fullCanonicalURL = `${baseURLClean}/`;
---

<!doctype html>
<html lang="es" class="scroll-smooth no-js">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={faviconURL} />
		<meta name="generator" content={Astro.generator} />

		<!-- Basic Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Marcos Rezk" />
		<link rel="canonical" href={fullCanonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="profile" />
		<meta property="og:url" content={fullCanonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullImageURL} />
		<meta property="og:locale" content="es_UY" />
		<meta property="og:site_name" content="Marcos Rezk" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={fullCanonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullImageURL} />
		<meta name="twitter:creator" content="@mrezk84" />

		<!-- Additional SEO -->
		<meta name="keywords" content="Marcos Rezk, Full Stack Developer, React Developer, C# Developer, .NET, SQL Server, ORT Uruguay, Web Developer, Software Developer, Uruguay, Montevideo, Backend, Frontend, contratar desarrollador" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<!-- Matches --c-paper in each scheme so the browser chrome blends in. -->
		<meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b1110" media="(prefers-color-scheme: dark)" />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Marcos Rezk",
			"jobTitle": "Full Stack Developer",
			"url": fullCanonicalURL,
			"image": fullImageURL,
			"email": "mailto:mrezk84@gmail.com",
			"telephone": "+59899845879",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Montevideo",
				"addressCountry": "UY"
			},
			"sameAs": [
				"https://www.linkedin.com/in/marcos-rezk",
				"https://github.com/mrezk84"
			],
			"alumniOf": {
				"@type": "CollegeOrUniversity",
				"name": "Universidad ORT Uruguay"
			},
			"worksFor": {
				"@type": "Organization",
				"name": "SONDA Uruguay"
			},
			"knowsLanguage": ["es", "en"],
			"knowsAbout": ["React", "C#", ".NET", "SQL Server", "PostgreSQL", "Java", "Spring Boot", "JavaScript", "Node.js", "Full Stack Development"],
			"description": "Desarrollador Full Stack con más de 3 años construyendo aplicaciones web de punta a punta con React, C# .NET, Java y SQL Server en entornos de alta disponibilidad."
		})}>
		</script>

		<!-- Runs before paint: sets the colour scheme and drops the no-js
		     guard so reveal animations can take over from the static fallback. -->
		<script is:inline>
			(function () {
				document.documentElement.classList.remove('no-js');
				const theme = localStorage.getItem('theme') || 'system';
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (theme === 'dark' || (theme === 'system' && prefersDark)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body class="bg-paper text-ink antialiased">
		<slot />

		<script>
			// Progressive reveal. Replaces the AOS dependency (and the React
			// island that existed only to initialise it). Anything already in
			// view on load is shown immediately so the first screen never
			// flashes empty.
			const revealables = document.querySelectorAll<HTMLElement>('.reveal');

			if (!('IntersectionObserver' in window)) {
				revealables.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const el = entry.target as HTMLElement;
							const delay = Number(el.dataset.revealDelay ?? 0);
							window.setTimeout(() => el.classList.add('is-visible'), delay);
							observer.unobserve(el);
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
				);

				revealables.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>
