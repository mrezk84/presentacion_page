---
import Icon from "./Icon.astro";

interface Repo {
	name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	updated_at: string;
	stargazers_count: number;
	forks_count: number;
	fork: boolean;
}

const githubUsername = "mrezk84";
const githubApiUrl = `https://api.github.com/users/${githubUsername}/repos?sort=updated&per_page=12`;

/**
 * Fetched at build time, so a slow or rate-limited GitHub delays the build
 * rather than the visitor. The timeout keeps a hanging API from stalling CI;
 * when the call fails the section still renders, just without the cards.
 */
let repos: Repo[] = [];

try {
	const response = await fetch(githubApiUrl, {
		headers: { Accept: "application/vnd.github+json", "User-Agent": "marcos-rezk-portfolio" },
		signal: AbortSignal.timeout(8000)
	});

	if (response.ok) {
		const data: Repo[] = await response.json();
		repos = data.filter((repo) => !repo.fork).slice(0, 6);
	} else {
		console.warn(`[GitHubRepos] GitHub respondió ${response.status}; se omiten las tarjetas.`);
	}
} catch (error) {
	console.warn("[GitHubRepos] No se pudieron obtener los repositorios:", error);
}

// Language dots use the palette rather than raw brand colours, so the section
// stays inside the design system instead of turning into confetti.
const languageTone: Record<string, string> = {
	TypeScript: "bg-pine",
	JavaScript: "bg-signal",
	Python: "bg-pine",
	HTML: "bg-signal",
	CSS: "bg-pine",
	Astro: "bg-signal",
	"C#": "bg-pine",
	Java: "bg-signal",
	Go: "bg-pine"
};

const toneFor = (lang: string | null) => (lang && languageTone[lang]) || "bg-line-strong";

const plural = (n: number, one: string, many: string) => `Hace ${n} ${n === 1 ? one : many}`;

const relativeDate = (value: string) => {
	const days = Math.max(1, Math.round((Date.now() - new Date(value).getTime()) / 86_400_000));
	if (days === 1) return "Ayer";
	if (days < 7) return plural(days, "día", "días");
	if (days < 30) return plural(Math.floor(days / 7), "semana", "semanas");
	if (days < 365) return plural(Math.floor(days / 30), "mes", "meses");
	return plural(Math.floor(days / 365), "año", "años");
};
---

<section id="github" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
	<div class="max-w-6xl mx-auto px-6">
		<div class="eyebrow mb-10 reveal">
			<span class="label label-pine">07 / Código abierto</span>
		</div>

		<div class="grid lg:grid-cols-12 gap-10 lg:gap-16 mb-14">
			<h2 class="lg:col-span-7 display-xl text-[clamp(2rem,4.5vw,3.25rem)] reveal">
				Lo que sí puedo mostrarte.
			</h2>
			<p class="lg:col-span-5 text-ink-soft leading-relaxed self-end reveal" data-reveal-delay="100">
				Fuera del trabajo construyo con React y Next.js, APIs en Node y algo
				de Python. Acá abajo están los repositorios que tengo públicos: menos
				críticos que mi trabajo diario, pero es código mío y podés leerlo.
			</p>
		</div>

		{repos.length > 0 ? (
			<>
				<!-- Hairlines come from each cell's own right/bottom border rather
				     than a gap-px well, so a partial last row leaves empty space
				     instead of a stray filled block. -->
				<div class="grid sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-line">
					{repos.map((repo, index) => (
						<a
							href={repo.html_url}
							target="_blank"
							rel="noopener noreferrer"
							class="group bg-paper p-6 flex flex-col border-r border-b border-line reveal"
							data-reveal-delay={index * 60}
						>
							<div class="flex items-start justify-between gap-3 mb-4">
								<h3 class="font-mono text-sm font-semibold text-ink group-hover:text-pine transition-colors break-all">
									{repo.name}
								</h3>
								<Icon
									name="arrow-up-right"
									class="w-4 h-4 shrink-0 mt-0.5 text-ink-faint transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-pine"
									strokeWidth={2}
								/>
							</div>

							<p class="text-sm text-ink-soft leading-relaxed mb-6 flex-1 line-clamp-3">
								{repo.description || "Sin descripción."}
							</p>

							<div class="flex items-center gap-4 pt-4 border-t border-line">
								{repo.language && (
									<span class="flex items-center gap-2 label">
										<span class={`w-1.5 h-1.5 rounded-full ${toneFor(repo.language)}`}></span>
										{repo.language}
									</span>
								)}
								{repo.stargazers_count > 0 && (
									<span class="flex items-center gap-1.5 label">
										<Icon name="star" class="w-3.5 h-3.5" strokeWidth={2} />
										{repo.stargazers_count}
									</span>
								)}
								<span class="label ml-auto">{relativeDate(repo.updated_at)}</span>
							</div>
						</a>
					))}
				</div>

				<div class="mt-10 reveal">
					<a
						href={`https://github.com/${githubUsername}?tab=repositories`}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-outline"
					>
						<Icon name="github" class="w-[18px] h-[18px]" />
						Ver todos los repositorios
					</a>
				</div>
			</>
		) : (
			<div class="border border-line bg-surface p-10 text-center reveal">
				<span class="inline-flex w-12 h-12 items-center justify-center border border-line text-pine mb-5">
					<Icon name="github" class="w-6 h-6" />
				</span>
				<p class="text-ink-soft mb-6 max-w-md mx-auto">
					El listado se genera desde la API de GitHub durante el build. Mientras
					tanto, podés ver todos mis repositorios directamente en mi perfil.
				</p>
				<a
					href={`https://github.com/${githubUsername}`}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline"
				>
					<Icon name="github" class="w-[18px] h-[18px]" />
					github.com/{githubUsername}
				</a>
			</div>
		)}
	</div>
</section>
