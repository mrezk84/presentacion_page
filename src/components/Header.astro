---
import Icon from "./Icon.astro";

const links = [
    { name: "Perfil", href: "#about" },
    { name: "Trayectoria", href: "#experiencia" },
    { name: "Proyectos", href: "#proyectos" },
    { name: "Stack", href: "#tecnologias" },
    { name: "Credenciales", href: "#credenciales" },
];
---

<header
    id="header"
    class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300 no-print"
>
    <nav class="max-w-6xl mx-auto px-6" aria-label="Navegación principal">
        <div class="flex items-center justify-between h-16 sm:h-[4.5rem]">

            <!-- Wordmark: monogram in a hairline box, like a stamped file header -->
            <a href="#inicio" class="group flex items-center gap-3" aria-label="Ir al inicio">
                <span class="w-9 h-9 flex items-center justify-center border border-line-strong text-pine font-mono text-xs font-semibold tracking-widest transition-colors group-hover:bg-pine group-hover:text-on-pine group-hover:border-pine">
                    MR
                </span>
                <span class="hidden sm:flex flex-col leading-none">
                    <span class="font-display text-[0.9375rem] font-bold text-ink">Marcos Rezk</span>
                    <span class="label text-[0.625rem]">Full Stack Developer</span>
                </span>
            </a>

            <!-- Desktop nav -->
            <div class="hidden lg:flex items-center gap-1">
                {links.map((link) => (
                    <a
                        href={link.href}
                        class="px-3 py-2 text-sm font-medium text-ink-soft hover:text-pine transition-colors"
                    >
                        {link.name}
                    </a>
                ))}

                <span class="w-px h-5 bg-line mx-3"></span>

                <button
                    id="theme-toggle"
                    class="w-9 h-9 flex items-center justify-center text-ink-soft hover:text-pine transition-colors"
                    aria-label="Cambiar entre modo claro y oscuro"
                >
                    <Icon name="sun" class="theme-icon-sun w-[18px] h-[18px]" strokeWidth={1.8} />
                    <Icon name="moon" class="theme-icon-moon w-[18px] h-[18px]" strokeWidth={1.8} />
                </button>

                <a href="#contacto" class="btn btn-signal ml-2 !py-2.5 !px-5 !text-sm">
                    Contratarme
                </a>
            </div>

            <!-- Mobile controls -->
            <div class="flex lg:hidden items-center gap-1">
                <button
                    id="theme-toggle-mobile"
                    class="w-10 h-10 flex items-center justify-center text-ink-soft"
                    aria-label="Cambiar entre modo claro y oscuro"
                >
                    <Icon name="sun" class="theme-icon-sun w-5 h-5" strokeWidth={1.8} />
                    <Icon name="moon" class="theme-icon-moon w-5 h-5" strokeWidth={1.8} />
                </button>

                <button
                    id="menu-toggle"
                    class="w-10 h-10 flex items-center justify-center text-ink"
                    aria-label="Abrir menú"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <Icon name="menu" class="menu-icon-open w-6 h-6" strokeWidth={1.8} />
                    <Icon name="close" class="menu-icon-close w-6 h-6 hidden" strokeWidth={1.8} />
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile menu -->
    <div
        id="mobile-menu"
        class="lg:hidden fixed inset-x-0 top-16 bottom-0 z-40 bg-paper border-t border-line translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
        aria-hidden="true"
    >
        <div class="px-6 py-8">
            <p class="label mb-5">Navegación</p>

            <nav class="flex flex-col border-t border-line mb-8">
                {links.map((link, index) => (
                    <a
                        href={link.href}
                        class="mobile-link flex items-baseline gap-4 py-4 border-b border-line text-xl font-display font-bold text-ink"
                    >
                        <span class="label w-6">{String(index + 1).padStart(2, "0")}</span>
                        {link.name}
                    </a>
                ))}
            </nav>

            <a href="#contacto" class="mobile-link btn btn-signal w-full mb-4">
                Contratarme
            </a>

            <div class="flex items-center gap-2">
                <a
                    href="https://www.linkedin.com/in/marcos-rezk"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn de Marcos Rezk"
                    class="flex-1 h-12 flex items-center justify-center border border-line text-ink-soft"
                >
                    <Icon name="linkedin" class="w-5 h-5" />
                </a>
                <a
                    href="https://github.com/mrezk84"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub de Marcos Rezk"
                    class="flex-1 h-12 flex items-center justify-center border border-line text-ink-soft"
                >
                    <Icon name="github" class="w-5 h-5" />
                </a>
                <a
                    href="https://wa.me/59899845879"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="WhatsApp de Marcos Rezk"
                    class="flex-1 h-12 flex items-center justify-center border border-line text-ink-soft"
                >
                    <Icon name="whatsapp" class="w-5 h-5" />
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    #header.is-scrolled {
        background-color: color-mix(in srgb, var(--c-paper) 82%, transparent);
        backdrop-filter: blur(14px) saturate(140%);
        -webkit-backdrop-filter: blur(14px) saturate(140%);
        border-bottom-color: var(--c-line);
    }
</style>

<script>
    const header = document.getElementById("header");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIconOpen = document.querySelector<SVGElement>(".menu-icon-open");
    const menuIconClose = document.querySelector<SVGElement>(".menu-icon-close");

    let menuOpen = false;

    function setMenu(open: boolean) {
        menuOpen = open;
        mobileMenu?.classList.toggle("translate-x-full", !open);
        mobileMenu?.setAttribute("aria-hidden", String(!open));
        menuIconOpen?.classList.toggle("hidden", open);
        menuIconClose?.classList.toggle("hidden", !open);
        menuToggle?.setAttribute("aria-expanded", String(open));
        menuToggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
        document.body.style.overflow = open ? "hidden" : "";
    }

    menuToggle?.addEventListener("click", () => setMenu(!menuOpen));
    document.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => setMenu(false));
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menuOpen) setMenu(false);
    });
    // Leaving the mobile breakpoint with the menu open would otherwise strand
    // `overflow: hidden` on the body.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
        if (event.matches && menuOpen) setMenu(false);
    });

    // Scroll state, read once per frame instead of once per scroll event.
    let ticking = false;
    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            header?.classList.toggle("is-scrolled", window.scrollY > 24);
            ticking = false;
        });
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    // Theme. 'system' follows the OS until the user overrides it explicitly.
    function currentTheme() {
        return localStorage.getItem("theme") || "system";
    }

    function applyTheme(theme: string) {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = theme === "dark" || (theme === "system" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
    }

    function toggleTheme() {
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = document.documentElement.classList.contains("dark");
        // Toggling back to the OS preference is a no-op the user can't see, so
        // always store the explicit opposite of what's on screen.
        const next = isDark ? "light" : "dark";
        localStorage.setItem("theme", next === (prefersDark ? "dark" : "light") ? "system" : next);
        applyTheme(next);
    }

    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
    document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (currentTheme() === "system") applyTheme("system");
    });
</script>
