const inner = isFilled ? filled[name] : (stroked[name] ?? '');
---
{isFilled ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 16 16"
    fill="currentColor"
    class={className}
    aria-hidden="true"
    set:html={inner}
  />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    class={className}
    aria-hidden="true"
    set:html={inner}
  />
)}
