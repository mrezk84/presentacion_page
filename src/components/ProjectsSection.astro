---
import Icon from "./Icon.astro";
import ProjectDiagram from "./ProjectDiagram.astro";

/**
 * Professional work only. Personal repositories are rendered once, by
 * GitHubRepos.astro — this section used to duplicate them.
 *
 * These systems are client-owned and not publicly reachable, so each entry
 * carries an architecture diagram instead of a screenshot: it shows how the
 * pieces talk without exposing anything that belongs to the client.
 */
const projects = [
	{
		id: "denuncias" as const,
		title: "Sistema de Denuncias",
		client: "Ministerio del Interior",
		year: "2024",
		icon: "building",
		description:
			"Aplicación full stack para la gestión de denuncias ciudadanas. Mapa interactivo con ArcGIS, autenticación LDAP contra el directorio del organismo y exportación de reportes en PDF.",
		outcome: "40% de mejora en el tiempo de respuesta de las consultas",
		diagramLabel:
			"Arquitectura del sistema de denuncias: una SPA en React consulta una API en C# .NET que valida la sesión contra LDAP, persiste en SQL Server, geocodifica el hecho con ArcGIS y exporta reportes en PDF. El tramo optimizado es el de las consultas a SQL Server.",
		caption: "El trabajo de optimización estuvo en el tramo API → SQL Server.",
		technologies: ["React", "C# .NET", "SQL Server", "ArcGIS", "LDAP"]
	},
	{
		id: "emergencias" as const,
		title: "Centro de Emergencias 911",
		client: "Ministerio del Interior",
		year: "2023",
		icon: "phone",
		description:
			"Sistema crítico de gestión de llamadas de emergencia: grabación de audio, geolocalización del incidente y distribución de despachos en tiempo real. Cliente XAML, servicios WCF e integración Asterisk para telefonía IP.",
		outcome: "Operación 24/7 sobre infraestructura del Estado",
		diagramLabel:
			"Arquitectura del Centro de Emergencias 911: la llamada entra por Asterisk vía SIP, que emite un evento a los servicios WCF. Estos graban el audio, obtienen la ubicación con ArcGIS y arman la ficha que llega al operador en un cliente XAML, desde donde sale el despacho en tiempo real.",
		caption: "Una llamada abre tres caminos en paralelo antes de llegar al operador.",
		technologies: ["C# .NET", "WCF", "XAML", "ArcGIS", "Asterisk"]
	},
	{
		id: "semm" as const,
		title: "Gestión de Eventos SEMM",
		client: "SEMM",
		year: "2023",
		icon: "shield",
		description:
			"Plataforma de gestión y monitoreo de eventos para un servicio de emergencia médica móvil, con tablero en tiempo real y módulo de estadísticas operativas.",
		outcome: "Tablero en tiempo real para coordinación médica",
		diagramLabel:
			"Arquitectura de la plataforma SEMM: los eventos médicos se registran a través de una API en C# .NET que persiste en SQL Server; el tablero React lee ese histórico en vivo y alimenta las estadísticas operativas con Chart.js.",
		caption: "El tablero lee el mismo histórico que alimenta las estadísticas.",
		technologies: ["React", "C# .NET", "SQL Server", "Chart.js"]
	}
];
---

<section id="proyectos" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
	<div class="max-w-6xl mx-auto px-6">
		<div class="eyebrow mb-10 reveal">
			<span class="label label-pine">04 / Proyectos</span>
		</div>

		<div class="grid lg:grid-cols-12 gap-10 lg:gap-16 mb-16">
			<h2 class="lg:col-span-7 display-xl text-[clamp(2rem,4.5vw,3.25rem)] reveal">
				Tres sistemas que siguen funcionando hoy.
			</h2>
			<p class="lg:col-span-5 text-ink-soft leading-relaxed self-end reveal" data-reveal-delay="100">
				Son de clientes, así que no puedo mostrarte el código ni una demo.
				Lo que sí puedo es contarte cómo están armados por dentro y por
				qué los resolví así.
			</p>
		</div>

		<div class="space-y-px bg-line border border-line">
			{projects.map((project, index) => (
				<article class="bg-paper reveal" data-reveal-delay={index * 80}>
					<!-- Cabecera a modo de pestaña de expediente -->
					<div class="flex items-center justify-between gap-4 px-6 sm:px-8 py-3 border-b border-line">
						<span class="label truncate">{project.client}</span>
						<span class="label label-pine shrink-0">{project.year}</span>
					</div>

					<div class="grid lg:grid-cols-12">
						<!-- Ficha -->
						<div class="lg:col-span-5 p-6 sm:p-8 flex flex-col">
							<span class="w-11 h-11 flex items-center justify-center border border-line text-pine mb-5">
								<Icon name={project.icon} class="w-5 h-5" />
							</span>

							<h3 class="font-display text-2xl sm:text-3xl font-bold text-ink leading-tight mb-3">
								{project.title}
							</h3>

							<p class="text-sm text-ink-soft leading-relaxed mb-6 flex-1">
								{project.description}
							</p>

							<div class="flex items-start gap-2.5 mb-6 pt-5 border-t border-line">
								<Icon name="check" class="w-4 h-4 mt-0.5 shrink-0 text-signal" strokeWidth={2.5} />
								<p class="text-sm font-medium text-ink leading-snug">{project.outcome}</p>
							</div>

							<ul class="flex flex-wrap gap-1.5">
								{project.technologies.map((tech) => (
									<li class="label px-2.5 py-1 bg-sunk border border-line">{tech}</li>
								))}
							</ul>
						</div>

						<!-- Diagrama -->
						<div class="lg:col-span-7 p-6 sm:p-8 border-t lg:border-t-0 lg:border-l border-line bg-sunk/40">
							<p class="label mb-5">Arquitectura</p>
							<ProjectDiagram id={project.id} label={project.diagramLabel} />
							<p class="text-xs text-ink-faint leading-relaxed mt-5">{project.caption}</p>
						</div>
					</div>
				</article>
			))}
		</div>

		<p class="mt-8 text-sm text-ink-faint reveal">
			¿Necesitás detalle técnico o referencias? <a href="#contacto" class="link-draw font-medium">Pedímelo y te lo cuento</a>.
		</p>
	</div>
</section>
