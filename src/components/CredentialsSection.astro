---
import Icon from "./Icon.astro";

/**
 * Merges what used to be three thin sections — Certificaciones, Educación and
 * Idiomas — into one credentials block. Same information, a third of the
 * scrolling, and it reads as a single verifiable record.
 */

const isVercel = import.meta.env.VERCEL === '1';
const isDevelopment = import.meta.env.DEV;
const basePath = isVercel || isDevelopment ? '' : '/presentacion_page';

interface Credential {
	title: string;
	institution: string;
	year: string;
	kind: string;
	icon: string;
	credentialId?: string;
	/** Public proof, when there is one. Omitted entries render without a link. */
	link?: string;
}

const credentials: Credential[] = [
	{
		title: "Claude Code: Guía completa para desarrolladores de software",
		institution: "Udemy · Fernando Herrera, DevTalles · 19 horas",
		year: "2026",
		kind: "Certificación profesional",
		icon: "spark",
		credentialId: "UC-cd21aeee",
		link: `${basePath}/UC-cd21aeee-4dad-48fb-8168-eadeb5e77c49.pdf`
	},
	{
		title: "Analista Programador",
		institution: "Universidad ORT Uruguay · con títulos intermedios de Programador Orientado a Objetos y Programador Web",
		year: "2024",
		kind: "Carrera universitaria",
		icon: "academic",
		link: `${basePath}/titulo.png`
	},
	{
		title: "Agile Frameworks: Scrum & Kanban",
		institution: "Udemy",
		year: "2024",
		kind: "Certificación profesional",
		icon: "board",
		credentialId: "UC-12a8ec05",
		link: `${basePath}/UC-12a8ec05-abc6-4bc2-a6dc-3234366d9585.pdf`
	},
	{
		title: "Analista en Tecnologías de la Información",
		institution: "Universidad ORT Uruguay",
		year: "2019",
		kind: "Carrera universitaria",
		icon: "academic"
	},
	{
		title: "Desarrollo Mobile Android",
		institution: "Instituto BIOS",
		year: "2015",
		kind: "Especialización",
		icon: "window"
	},
	{
		title: "Técnico en Hardware y Software",
		institution: "IAC Computación",
		year: "2003",
		kind: "Certificación técnica",
		icon: "cube"
	}
];

const languages = [
	{ name: "Español", level: "Nativo", detail: "Lengua materna" },
	{ name: "Inglés", level: "Lectura técnica fluida · conversación básica-intermedia", detail: "Alianza Cultural Uruguay-Estados Unidos" }
];
---

<section id="credenciales" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
	<div class="max-w-6xl mx-auto px-6">
		<div class="eyebrow mb-10 reveal">
			<span class="label label-pine">06 / Credenciales</span>
		</div>

		<h2 class="display-xl text-[clamp(2rem,4.5vw,3.25rem)] mb-14 max-w-2xl reveal">
			Formación, certificaciones e idiomas.
		</h2>

		<div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

			<!-- Credentials record -->
			<div class="lg:col-span-2">
				<p class="label mb-5">Registro académico</p>

				<ul class="border-t border-line">
					{credentials.map((cred, index) => (
						<li
							class="group flex flex-wrap sm:flex-nowrap items-start gap-4 sm:gap-6 py-5 border-b border-line reveal"
							data-reveal-delay={index * 60}
						>
							<span class="shrink-0 w-11 h-11 flex items-center justify-center border border-line text-pine transition-colors duration-300 group-hover:bg-pine group-hover:text-on-pine group-hover:border-pine">
								<Icon name={cred.icon} class="w-5 h-5" />
							</span>

							<div class="flex-1 min-w-0">
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
									<span class="label label-pine">{cred.year}</span>
									<span class="label">{cred.kind}</span>
								</div>
								<h3 class="font-display text-lg font-bold text-ink leading-tight">{cred.title}</h3>
								<p class="text-sm text-ink-soft">{cred.institution}</p>
								{cred.credentialId && (
									<p class="label mt-2">ID · {cred.credentialId}</p>
								)}
							</div>

							{cred.link ? (
								<a
									href={cred.link}
									target="_blank"
									rel="noopener noreferrer"
									class="shrink-0 inline-flex items-center gap-2 label label-pine hover:text-ink transition-colors self-center"
								>
									Ver
									<Icon name="arrow-up-right" class="w-3.5 h-3.5" strokeWidth={2} />
								</a>
							) : (
								<span class="shrink-0 label self-center">Sin copia digital</span>
							)}
						</li>
					))}
				</ul>
			</div>

			<!-- Languages -->
			<div>
				<p class="label mb-5">Idiomas</p>

				<div class="space-y-px bg-line border border-line">
					{languages.map((lang, index) => (
						<div class="bg-paper p-6 reveal" data-reveal-delay={index * 80}>
							<div class="flex items-baseline justify-between gap-3 mb-1">
								<h3 class="font-display text-xl font-bold text-ink">{lang.name}</h3>
							</div>
							<p class="text-sm font-medium text-ink-soft">{lang.level}</p>
							<p class="label mt-1">{lang.detail}</p>
						</div>
					))}
				</div>

				<div class="mt-6 border border-line bg-surface p-6">
					<p class="label mb-3">Formación continua</p>
					<p class="text-sm text-ink-soft leading-relaxed">
						Egresado en 2024, con quince años de experiencia previa en operación
						y gestión de sistemas. Sigo sumando stack — Go y Spring Boot son los
						últimos en entrar.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
