---
import Icon from "./Icon.astro";
---

<button
	id="scroll-to-top"
	aria-label="Volver arriba"
	class="fixed bottom-6 right-6 z-40 w-12 h-12 flex items-center justify-center bg-pine text-on-pine opacity-0 translate-y-2 pointer-events-none transition-all duration-300 no-print"
	style="box-shadow: var(--shadow-lg);"
>
	<Icon name="arrow-up" class="w-5 h-5" strokeWidth={2} />
</button>

<script>
	const button = document.getElementById("scroll-to-top");
	const THRESHOLD = 600;

	let ticking = false;
	function update() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			const visible = window.scrollY > THRESHOLD;
			button?.classList.toggle("opacity-0", !visible);
			button?.classList.toggle("translate-y-2", !visible);
			button?.classList.toggle("pointer-events-none", !visible);
			ticking = false;
		});
	}

	button?.addEventListener("click", () => {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
	});

	window.addEventListener("scroll", update, { passive: true });
	update();
</script>
