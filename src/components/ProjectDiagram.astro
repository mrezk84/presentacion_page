---
/**
 * ProjectDiagram.astro — diagramas de arquitectura de los proyectos.
 *
 * Hechos a mano con SVG nativo: sin librerías, sin runtime, sin imágenes.
 * Los trazos usan `currentColor` y los tokens del sistema, así que el
 * diagrama se relee solo en modo claro y oscuro.
 *
 * Sólo describen el flujo de datos entre componentes, con las tecnologías
 * que ya figuran públicamente en el CV. No exponen esquemas, endpoints,
 * hosts ni ninguna otra cosa que pertenezca al cliente.
 */
interface Props {
	id: "denuncias" | "emergencias" | "semm";
	label: string;
}

const { id, label } = Astro.props;
---

<figure class="diagram">
	<svg
		viewBox="0 0 640 320"
		role="img"
		aria-label={label}
		xmlns="http://www.w3.org/2000/svg"
	>
		<defs>
			<!-- Ids prefijados: hay tres diagramas en la misma página. -->
			<marker id={`${id}-tip`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="tip" />
			</marker>
			<marker id={`${id}-tip-key`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="tip-key" />
			</marker>
		</defs>

		{id === "denuncias" && (
			<g>
				{/* Misma grilla de 3 columnas que los otros dos diagramas: cajas de
				    150 con calles de 70. Los subtítulos se mantienen cortos para
				    que no desborden la caja cuando el tipo crece en móvil. */}
				<rect class="node" x="245" y="14" width="150" height="56" />
				<text class="n-title" x="320" y="38">LDAP</text>
				<text class="n-sub" x="320" y="55">directorio</text>

				{/* Ruta principal */}
				<rect class="node" x="25" y="122" width="150" height="56" />
				<text class="n-title" x="100" y="146">React SPA</text>
				<text class="n-sub" x="100" y="163">funcionario</text>

				<rect class="node" x="245" y="122" width="150" height="56" />
				<text class="n-title" x="320" y="146">API C# .NET</text>
				<text class="n-sub" x="320" y="163">reglas</text>

				<rect class="node" x="465" y="122" width="150" height="56" />
				<text class="n-title" x="540" y="146">SQL Server</text>
				<text class="n-sub" x="540" y="163">denuncias</text>

				{/* Servicios de apoyo */}
				<rect class="node" x="135" y="248" width="150" height="56" />
				<text class="n-title" x="210" y="272">ArcGIS</text>
				<text class="n-sub" x="210" y="289">ubicación</text>

				<rect class="node" x="355" y="248" width="150" height="56" />
				<text class="n-title" x="430" y="272">Reporte PDF</text>
				<text class="n-sub" x="430" y="289">exportación</text>

				<line class="edge" x1="175" y1="150" x2="239" y2="150" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="207" y="141">REST</text>

				<line class="edge" x1="395" y1="150" x2="459" y2="150" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="427" y="141">consulta</text>

				<line class="edge" x1="320" y1="122" x2="320" y2="76" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="334" y="103" text-anchor="start">valida sesión</text>

				<polyline class="edge" points="320,178 320,214 210,214 210,242" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="255" y="206">geocodifica</text>

				<polyline class="edge" points="320,178 320,214 430,214 430,242" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="388" y="206">exporta</text>
			</g>
		)}

		{id === "emergencias" && (
			<g>
				{/* Grilla de 3 columnas: cajas de 170 con calles de 50, para que
				    las etiquetas de las flechas cortas entren sin pisar las cajas. */}
				<rect class="node" x="15" y="14" width="170" height="56" />
				<text class="n-title" x="100" y="38">Llamada entrante</text>
				<text class="n-sub" x="100" y="55">ciudadano</text>

				<rect class="node" x="235" y="14" width="170" height="56" />
				<text class="n-title" x="320" y="38">Asterisk</text>
				<text class="n-sub" x="320" y="55">telefonía IP</text>

				<rect class="node" x="235" y="130" width="170" height="56" />
				<text class="n-title" x="320" y="154">Servicios WCF</text>
				<text class="n-sub" x="320" y="171">orquestación</text>

				<rect class="node" x="455" y="130" width="170" height="56" />
				<text class="n-title" x="540" y="154">ArcGIS</text>
				<text class="n-sub" x="540" y="171">geolocalización</text>

				{/* La persistencia faltaba en la primera versión de este diagrama:
				    es justamente el tramo del que habla el caso técnico. */}
				<rect class="node node--key" x="15" y="130" width="170" height="56" />
				<text class="n-title" x="100" y="154">SQL Server</text>
				<text class="n-sub" x="100" y="171">registro</text>

				<rect class="node" x="15" y="246" width="170" height="56" />
				<text class="n-title" x="100" y="270">Grabación</text>
				<text class="n-sub" x="100" y="287">respaldo</text>

				<rect class="node" x="455" y="246" width="170" height="56" />
				<text class="n-title" x="540" y="270">Operador XAML</text>
				<text class="n-sub" x="540" y="287">ficha y despacho</text>

				<line class="edge" x1="185" y1="42" x2="229" y2="42" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="207" y="33">SIP</text>

				<line class="edge" x1="320" y1="70" x2="320" y2="124" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="334" y="101" text-anchor="start">evento</text>

				<line class="edge edge--key" x1="235" y1="158" x2="191" y2="158" marker-end={`url(#${id}-tip-key)`} />
				<text class="e-label e-label--key" x="213" y="149">guarda</text>
				<text class="e-label e-label--key" x="213" y="178">−40 %</text>

				<polyline class="edge" points="320,186 320,210 100,210 100,240" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="210" y="202">graba</text>

				<line class="edge" x1="405" y1="158" x2="449" y2="158" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="427" y="149">ubica</text>

				<line class="edge" x1="540" y1="186" x2="540" y2="240" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="526" y="205" text-anchor="end">posición</text>

				<polyline class="edge" points="320,186 320,226 490,226 490,240" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="405" y="242">despacho en vivo</text>
			</g>
		)}

		{id === "semm" && (
			<g>
				<rect class="node" x="15" y="14" width="170" height="56" />
				<text class="n-title" x="100" y="38">Evento médico</text>
				<text class="n-sub" x="100" y="55">alta desde base</text>

				<rect class="node" x="235" y="14" width="170" height="56" />
				<text class="n-title" x="320" y="38">API C# .NET</text>
				<text class="n-sub" x="320" y="55">validación</text>

				<rect class="node" x="455" y="14" width="170" height="56" />
				<text class="n-title" x="540" y="38">SQL Server</text>
				<text class="n-sub" x="540" y="55">histórico</text>

				<rect class="node node--key" x="235" y="196" width="170" height="56" />
				<text class="n-title" x="320" y="220">Tablero React</text>
				<text class="n-sub" x="320" y="237">coordinación</text>

				<rect class="node" x="455" y="196" width="170" height="56" />
				<text class="n-title" x="540" y="220">Chart.js</text>
				<text class="n-sub" x="540" y="237">estadísticas</text>

				<line class="edge" x1="185" y1="42" x2="229" y2="42" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="207" y="33">alta</text>

				<line class="edge" x1="405" y1="42" x2="449" y2="42" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="427" y="33">guarda</text>

				<polyline class="edge edge--key" points="540,70 540,133 320,133 320,190" marker-end={`url(#${id}-tip-key)`} />
				<text class="e-label e-label--key" x="430" y="125">lectura en vivo</text>

				<line class="edge" x1="405" y1="224" x2="449" y2="224" marker-end={`url(#${id}-tip)`} />
				<text class="e-label" x="427" y="215">KPIs</text>
			</g>
		)}
	</svg>
</figure>

<style>
	.diagram {
		margin: 0;
		color: var(--c-ink);
	}

	.diagram svg {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
	}

	/* Cajas: relleno de superficie, contorno heredado del texto para que
	   ambos temas mantengan el mismo peso visual. */
	.node {
		fill: var(--c-surface);
		stroke: currentColor;
		stroke-opacity: 0.22;
		stroke-width: 1;
	}

	.node--key {
		stroke: var(--c-signal);
		stroke-opacity: 1;
		stroke-width: 1.5;
	}

	.n-title {
		fill: currentColor;
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		text-anchor: middle;
	}

	.n-sub {
		fill: currentColor;
		fill-opacity: 0.55;
		font-family: var(--font-mono);
		font-size: 10px;
		text-anchor: middle;
	}

	.edge {
		fill: none;
		stroke: var(--c-pine);
		stroke-width: 1.5;
	}

	.edge--key {
		stroke: var(--c-signal);
	}

	.tip {
		fill: var(--c-pine);
	}

	.tip-key {
		fill: var(--c-signal);
	}

	.e-label {
		fill: var(--c-pine);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.04em;
		text-anchor: middle;
	}

	.e-label--key {
		fill: var(--c-signal);
	}

	@media (max-width: 640px) {
		/* A ancho de teléfono el SVG se reduce demasiado para leer 10px:
		   subimos el tipo dentro del propio sistema de coordenadas. */
		.n-title {
			font-size: 15px;
		}
		.n-sub,
		.e-label {
			font-size: 12px;
		}
	}
</style>
