---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SkipLink from "../components/SkipLink.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import GitHubRepos from "../components/GitHubRepos.astro";
import CredentialsSection from "../components/CredentialsSection.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

const isVercel = import.meta.env.VERCEL === '1';
const isDevelopment = import.meta.env.DEV;
const basePath = isVercel || isDevelopment ? '' : '/presentacion_page';

// Formspree form ID, e.g. "xrgvabcd". Set VITE_FORMSPREE_ENDPOINT to a full
// URL or a bare form ID. Without it the form falls back to a mailto: action
// so the page never ships a silently broken submit button.
const formspreeEndpoint = (import.meta.env.VITE_FORMSPREE_ENDPOINT ?? "").trim();
const formAction = formspreeEndpoint
  ? (formspreeEndpoint.startsWith("http")
      ? formspreeEndpoint
      : `https://formspree.io/f/${formspreeEndpoint.replace(/^\/?f\//, '')}`)
  : "mailto:mrezk84@gmail.com";
const formIsLive = Boolean(formspreeEndpoint);

const name = "Marcos Rezk";
const role = "Full Stack Developer";

// Availability facts a hiring manager screens for in the first 10 seconds.
const availability = [
  { label: "Ubicación", value: "Montevideo, Uruguay" },
  { label: "Modalidad", value: "Remoto · Híbrido · Presencial" },
  { label: "Zona horaria", value: "UTC−3 · solapa con LATAM y EE.UU." },
  { label: "Respuesta", value: "Menos de 24 h hábiles" }
];

const stats = [
  { value: "40", unit: "%", label: "Mejora de rendimiento en consultas SQL Server", note: "Sistema de denuncias" },
  { value: "15", unit: "+", label: "Años sosteniendo software en producción", note: "Soporte, gestión y desarrollo" },
  { value: "13", unit: "", label: "Personas coordinadas en mesa de ayuda", note: "Proyecto ANCAP" },
  { value: "3", unit: "+", label: "Años desarrollando full stack", note: "React · C# .NET · SQL Server" }
];

const marqueeItems = [
  "React", "C# .NET", "SQL Server", "Java", "Spring Boot", "PostgreSQL",
  "Node.js", "Go", "MongoDB", "XAML", "WCF", "REST APIs", "ArcGIS",
  "LDAP", "Asterisk", "Docker", "Git", "Scrum"
];

const capabilities = [
  {
    icon: "server",
    title: "Backend y APIs",
    lead: "Servicios que sostienen operación real, no demos.",
    body: "APIs REST y SOAP en C# .NET, Java con Spring Boot y Node.js. Integraciones con directorios corporativos, servicios de mapas y telefonía IP.",
    stack: ["C# .NET", "Java", "Spring Boot", "Node.js", "Go", "WCF"]
  },
  {
    icon: "database",
    title: "Datos y rendimiento",
    lead: "Donde suele estar el cuello de botella.",
    body: "Diseño de esquemas, índices y procedimientos almacenados. Optimización de consultas con 40% de mejora medida en producción sobre SQL Server.",
    stack: ["SQL Server", "PostgreSQL", "MongoDB"]
  },
  {
    icon: "code",
    title: "Frontend de producto",
    lead: "Interfaces que la gente usa ocho horas por día.",
    body: "Aplicaciones React y clientes de escritorio pensados para uso intensivo: flujos densos en información, accesibles y rápidos bajo carga.",
    stack: ["React", "JavaScript", "HTML / CSS", "XAML"]
  },
  {
    icon: "team",
    title: "Entrega y equipo",
    lead: "Vengo del otro lado de la mesa de soporte.",
    body: "Scrum y Kanban, CI/CD, revisión de código y pair programming. Nueve años gestionando proyectos técnicos antes de desarrollarlos.",
    stack: ["Scrum", "Kanban", "CI/CD", "Git", "Docker"]
  }
];

const experience = [
  {
    title: "Desarrollador Full Stack",
    org: "SONDA Uruguay",
    period: "2022 — Presente",
    current: true,
    bullets: [
      "Desarrollo full stack en React, C# .NET y XAML sobre sistemas de alta disponibilidad.",
      "Sistema 911 con WCF, ArcGIS y Asterisk para telefonía IP.",
      "Optimización de SQL Server con 40% de mejora en rendimiento."
    ]
  },
  {
    title: "Supervisor de Mesa de Ayuda",
    org: "Proyecto ANCAP a través de SONDA",
    period: "2018 — 2022",
    current: false,
    bullets: [
      "Gestión de un equipo de soporte técnico de 13 personas.",
      "Coordinación con áreas técnicas para el cierre de tickets críticos."
    ]
  },
  {
    title: "Manager",
    org: "SONDA Uruguay",
    period: "2009 — 2018",
    current: false,
    bullets: [
      "Coordinación de proyectos técnicos a nivel nacional.",
      "Supervisión de la implementación de soluciones empresariales."
    ]
  }
];

const stack = [
  { group: "Frontend", icon: "code", items: ["React", "JavaScript", "HTML / CSS", "XAML"] },
  { group: "Backend", icon: "server", items: ["C# .NET", "Java", "Spring Boot", "Node.js", "Go"] },
  { group: "Datos", icon: "database", items: ["SQL Server", "PostgreSQL", "MongoDB"] },
  { group: "Integraciones", icon: "link", items: ["REST APIs", "WCF", "ArcGIS", "LDAP", "Asterisk"] },
  { group: "Entorno", icon: "terminal", items: ["Visual Studio", "VS Code", "IntelliJ IDEA", "GoLand", "SSMS"] },
  { group: "Entrega", icon: "cycle", items: ["Git", "Docker", "Postman", "Scrum", "Kanban", "CI/CD"] }
];
---

<Layout
  title="Marcos Rezk | Full Stack Developer — disponible para nuevos proyectos"
  description="Full Stack Developer en Montevideo. React, C# .NET, SQL Server, Java y Spring Boot. Más de tres años construyendo aplicaciones web de punta a punta en entornos de alta disponibilidad. Disponible para nuevas oportunidades."
>
  <SkipLink />
  <Header />
  <ScrollToTop />

  <main id="main-content" role="main">

    <!-- ══════════════════════════════════════════════════════
         HERO
         Asymmetric 7/5 split. The left column carries the claim,
         the right one carries the evidence card.
         ══════════════════════════════════════════════════════ -->
    <section id="inicio" class="relative overflow-hidden grain pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="blueprint absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div
        class="absolute -top-24 -right-32 w-[36rem] h-[36rem] rounded-full pointer-events-none opacity-40"
        style="background: radial-gradient(circle, var(--c-pine-wash) 0%, transparent 66%);"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

          <!-- Claim -->
          <div class="lg:col-span-7">
            <div class="rise flex items-center gap-3 mb-8" style="animation-delay: 40ms;">
              <span class="pulse-dot"></span>
              <span class="label label-signal">Disponible para nuevos proyectos</span>
            </div>

            <h1 class="display-xl text-[clamp(2.75rem,7.5vw,5rem)] mb-7">
              <span class="rise block" style="animation-delay: 120ms;">Construyo software</span>
              <span class="rise block text-pine" style="animation-delay: 200ms;">que aguanta producción.</span>
            </h1>

            <p class="rise measure text-lg sm:text-xl text-ink-soft leading-relaxed mb-8" style="animation-delay: 280ms;">
              Soy <strong class="text-ink font-semibold">{name}</strong>, {role} en Montevideo. Trabajo el ciclo completo: interfaces en <strong class="text-ink font-semibold">React</strong>, APIs en <strong class="text-ink font-semibold">C# .NET</strong> y <strong class="text-ink font-semibold">Java</strong>, y bases de datos que rinden bajo carga. Me formé en sistemas donde la disponibilidad no se negocia, y esa forma de trabajar viaja bien a cualquier producto con usuarios de verdad.
            </p>

            <div class="rise flex flex-col sm:flex-row gap-3 mb-12" style="animation-delay: 360ms;">
              <a href="#contacto" class="btn btn-signal">
                <Icon name="mail" class="w-[18px] h-[18px]" strokeWidth={2} />
                Hablemos de tu proyecto
              </a>
              <a
                href={`${basePath}/Marcos_Rezk_CV.pdf`}
                download
                class="btn btn-outline"
              >
                <Icon name="download" class="w-[18px] h-[18px]" strokeWidth={2} />
                Descargar CV
              </a>
            </div>

            <!-- Availability facts: the screening questions, answered up front. -->
            <dl class="rise grid grid-cols-2 gap-x-8 gap-y-5 border-t border-line pt-7" style="animation-delay: 440ms;">
              {availability.map((item) => (
                <div>
                  <dt class="label mb-1.5">{item.label}</dt>
                  <dd class="text-sm font-medium text-ink">{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Evidence card -->
          <div class="lg:col-span-5 rise" style="animation-delay: 320ms;">
            <div class="card ticked relative">
              <div class="flex items-center justify-between px-5 py-3 border-b border-line">
                <span class="label label-pine">Perfil</span>
                <span class="label">UY · UTC−3</span>
              </div>

              <div class="p-5">
                <div class="relative mb-5 overflow-hidden">
                  <img
                    src={`${basePath}/perfil.jpg`}
                    alt="Retrato de Marcos Rezk"
                    width="440"
                    height="440"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full aspect-square object-cover"
                  />
                  <div class="absolute bottom-0 inset-x-0 flex items-center gap-2 px-3 py-2 bg-signal text-on-signal">
                    <span class="pulse-dot" style="background: currentColor;"></span>
                    <span class="label" style="color: currentColor;">Open to work</span>
                  </div>
                </div>

                <p class="font-display text-2xl font-bold text-ink leading-tight">{name}</p>
                <p class="text-sm text-ink-soft mb-5">{role} · Analista Programador</p>

                <ul class="space-y-2.5 border-t border-line pt-5">
                  {[
                    "Full stack: React, C# .NET, Java y SQL Server",
                    "Integraciones: REST, SOAP, LDAP, mapas y telefonía IP",
                    "Sistemas 24/7 para el Estado y para salud",
                    "Analista Programador — Universidad ORT"
                  ].map((item) => (
                    <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                      <Icon name="check" class="w-4 h-4 mt-0.5 shrink-0 text-pine" strokeWidth={2.5} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         TECHNOLOGY TICKER
         ══════════════════════════════════════════════════════ -->
    <div class="border-y border-line bg-surface py-4 overflow-hidden" aria-hidden="true">
      <div class="marquee">
        {[0, 1].map(() => (
          <div class="marquee__track">
            {marqueeItems.map((item) => (
              <span class="label whitespace-nowrap flex items-center gap-3">
                <span class="w-1 h-1 rounded-full bg-pine"></span>
                {item}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         01 — NUMBERS
         ══════════════════════════════════════════════════════ -->
    <section class="py-20 sm:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="eyebrow mb-12 reveal">
          <span class="label label-pine">01 / En números</span>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line">
          {stats.map((stat, index) => (
            <div class="bg-paper p-6 sm:p-7 reveal" data-reveal-delay={index * 70}>
              <p class="font-display text-5xl sm:text-6xl font-bold text-pine leading-none mb-4 tracking-tight">
                {stat.value}<span class="text-3xl sm:text-4xl align-top">{stat.unit}</span>
              </p>
              <p class="text-sm font-medium text-ink leading-snug mb-1.5">{stat.label}</p>
              <p class="label">{stat.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         02 — CAPABILITIES
         ══════════════════════════════════════════════════════ -->
    <section id="about" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="eyebrow mb-10 reveal">
          <span class="label label-pine">02 / Qué resuelvo</span>
        </div>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 mb-16">
          <h2 class="lg:col-span-7 display-xl text-[clamp(2rem,4.5vw,3.25rem)] reveal">
            Cuatro frentes, un mismo criterio: que funcione en producción.
          </h2>
          <p class="lg:col-span-5 text-ink-soft leading-relaxed self-end reveal" data-reveal-delay="100">
            Me formé donde un error no espera al martes siguiente. Esa exigencia
            define cómo escribo código, cómo lo pruebo y qué considero terminado
            — y no cambia según la industria del producto.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-px bg-line border border-line">
          {capabilities.map((cap, index) => (
            <article class="group bg-paper p-7 sm:p-9 reveal" data-reveal-delay={index * 80}>
              <div class="flex items-start gap-4 mb-5">
                <span class="shrink-0 w-11 h-11 flex items-center justify-center border border-line text-pine transition-colors duration-300 group-hover:bg-pine group-hover:text-on-pine group-hover:border-pine">
                  <Icon name={cap.icon} class="w-5 h-5" />
                </span>
                <div>
                  <h3 class="font-display text-xl font-bold text-ink leading-tight">{cap.title}</h3>
                  <p class="text-sm text-pine font-medium">{cap.lead}</p>
                </div>
              </div>

              <p class="text-sm text-ink-soft leading-relaxed mb-6">{cap.body}</p>

              <ul class="flex flex-wrap gap-1.5">
                {cap.stack.map((tech) => (
                  <li class="label px-2.5 py-1 bg-sunk border border-line">{tech}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         03 — EXPERIENCE
         ══════════════════════════════════════════════════════ -->
    <section id="experiencia" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="eyebrow mb-10 reveal">
          <span class="label label-pine">03 / Trayectoria</span>
        </div>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="display-xl text-[clamp(2rem,4.5vw,3rem)] mb-5 reveal">
              Quince años sosteniendo software en producción.
            </h2>
            <p class="text-ink-soft leading-relaxed reveal" data-reveal-delay="100">
              Empecé sosteniendo la operación desde soporte y gestión. Hoy la
              construyo. Esa ruta poco habitual es la razón por la que pienso
              primero en quién va a usar el sistema a las tres de la mañana.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="timeline">
              {experience.map((job, index) => (
                <div
                  class:list={["timeline-node relative pb-10 last:pb-0 reveal", job.current && "timeline-node--current"]}
                  data-reveal-delay={index * 90}
                >
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                    <span class="label">{job.period}</span>
                    {job.current && (
                      <span class="label label-signal border border-signal px-2 py-0.5">Actual</span>
                    )}
                  </div>
                  <h3 class="font-display text-2xl font-bold text-ink leading-tight">{job.title}</h3>
                  <p class="text-sm font-medium text-pine mb-4">{job.org}</p>
                  <ul class="space-y-2">
                    {job.bullets.map((bullet) => (
                      <li class="flex items-start gap-2.5 text-sm text-ink-soft leading-relaxed">
                        <span class="mt-2 w-1 h-1 shrink-0 bg-line-strong"></span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 — Projects -->
    <ProjectsSection />

    <!-- ══════════════════════════════════════════════════════
         05 — STACK
         ══════════════════════════════════════════════════════ -->
    <section id="tecnologias" class="py-20 sm:py-24 border-t border-line scroll-mt-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="eyebrow mb-10 reveal">
          <span class="label label-pine">05 / Stack</span>
        </div>

        <h2 class="display-xl text-[clamp(2rem,4.5vw,3.25rem)] mb-14 max-w-2xl reveal">
          Herramientas con las que trabajo a diario.
        </h2>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line">
          {stack.map((cat, index) => (
            <div class="bg-paper p-7 reveal" data-reveal-delay={index * 60}>
              <div class="flex items-center gap-3 mb-5 pb-4 border-b border-line">
                <Icon name={cat.icon} class="w-[18px] h-[18px] text-pine" />
                <h3 class="label label-pine">{cat.group}</h3>
              </div>
              <ul class="flex flex-wrap gap-x-4 gap-y-2.5">
                {cat.items.map((item) => (
                  <li class="text-sm font-medium text-ink-soft">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 — Credentials -->
    <CredentialsSection />

    <!-- 07 — GitHub -->
    <GitHubRepos />

    <!-- ══════════════════════════════════════════════════════
         08 — CONTACT
         ══════════════════════════════════════════════════════ -->
    <section id="contacto" class="relative py-20 sm:py-28 border-t border-line grain scroll-mt-20 overflow-hidden">
      <div
        class="absolute -bottom-40 -left-32 w-[34rem] h-[34rem] rounded-full pointer-events-none"
        style="background: radial-gradient(circle, var(--c-signal-wash) 0%, transparent 68%);"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-6xl mx-auto px-6">
        <div class="eyebrow mb-10 reveal">
          <span class="label label-signal">08 / Contacto</span>
        </div>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 mb-14">
          <h2 class="lg:col-span-7 display-xl text-[clamp(2.25rem,5.5vw,4rem)] reveal">
            ¿Buscás alguien que ya haya sostenido sistemas en producción?
          </h2>
          <p class="lg:col-span-5 text-lg text-ink-soft leading-relaxed self-end reveal" data-reveal-delay="100">
            Contame qué estás construyendo. Respondo en menos de 24 horas hábiles,
            y si no soy la persona indicada para el puesto te lo digo de entrada.
          </p>
        </div>

        <div class="grid lg:grid-cols-12 gap-px bg-line border border-line">

          <!-- Direct channels -->
          <div class="lg:col-span-5 bg-paper p-7 sm:p-9 reveal">
            <p class="label mb-6">Canales directos</p>

            <div class="space-y-px bg-line border border-line mb-8">
              <a
                href="https://wa.me/59899845879?text=Hola%20Marcos%2C%20te%20escribo%20por%20una%20oportunidad%20laboral."
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 p-4 bg-surface hover:bg-sunk transition-colors"
              >
                <span class="shrink-0 w-10 h-10 flex items-center justify-center border border-line text-pine">
                  <Icon name="whatsapp" class="w-5 h-5" />
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-semibold text-ink">WhatsApp</span>
                  <span class="block label">+598 99 845 879</span>
                </span>
                <Icon name="arrow-right" class="w-4 h-4 text-ink-faint transition-transform group-hover:translate-x-1" strokeWidth={2} />
              </a>

              <a
                href="mailto:mrezk84@gmail.com"
                class="group flex items-center gap-4 p-4 bg-surface hover:bg-sunk transition-colors"
              >
                <span class="shrink-0 w-10 h-10 flex items-center justify-center border border-line text-pine">
                  <Icon name="mail" class="w-5 h-5" />
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-semibold text-ink">Email</span>
                  <span class="block label truncate">mrezk84@gmail.com</span>
                </span>
                <Icon name="arrow-right" class="w-4 h-4 text-ink-faint transition-transform group-hover:translate-x-1" strokeWidth={2} />
              </a>

              <a
                href="https://www.linkedin.com/in/marcos-rezk"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 p-4 bg-surface hover:bg-sunk transition-colors"
              >
                <span class="shrink-0 w-10 h-10 flex items-center justify-center border border-line text-pine">
                  <Icon name="linkedin" class="w-5 h-5" />
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-semibold text-ink">LinkedIn</span>
                  <span class="block label">/in/marcos-rezk</span>
                </span>
                <Icon name="arrow-right" class="w-4 h-4 text-ink-faint transition-transform group-hover:translate-x-1" strokeWidth={2} />
              </a>
            </div>

            <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-7">
              {availability.map((item) => (
                <div>
                  <dt class="label mb-1.5">{item.label}</dt>
                  <dd class="text-sm font-medium text-ink">{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Form -->
          <div class="lg:col-span-7 bg-paper p-7 sm:p-9 reveal" data-reveal-delay="100">
            <p class="label mb-6">Escribime</p>

            <form action={formAction} method="POST" class="space-y-5" novalidate data-live={String(formIsLive)}>
              <div>
                <label for="name" class="label block mb-2">Nombre completo</label>
                <input type="text" id="name" name="name" required class="field" placeholder="Tu nombre" autocomplete="name" />
                <p id="name-tip" class="field-tip">Ingresá tu nombre (mínimo 2 letras).</p>
              </div>

              <div>
                <label for="email" class="label block mb-2">Correo electrónico</label>
                <input type="email" id="email" name="email" required class="field" placeholder="tu@empresa.com" autocomplete="email" />
                <p id="email-tip" class="field-tip">Ingresá un correo electrónico válido.</p>
              </div>

              <div>
                <label for="message" class="label block mb-2">Mensaje</label>
                <textarea id="message" name="message" rows="6" required class="field resize-y" placeholder="Rol, equipo, stack, modalidad… lo que tengas."></textarea>
                <p id="message-tip" class="field-tip">Escribí un mensaje (mínimo 10 caracteres).</p>
              </div>

              <!-- Honeypot: bots fill it, humans never see it. -->
              <div class="absolute w-px h-px -m-px overflow-hidden" aria-hidden="true">
                <label for="company-website">No completar</label>
                <input type="text" id="company-website" name="_gotcha" tabindex="-1" autocomplete="off" />
              </div>

              <button type="submit" id="submit-contact" class="btn btn-signal w-full">
                <Icon name="send" class="w-[18px] h-[18px]" strokeWidth={2} />
                <span>Enviar mensaje</span>
              </button>

              <p class="text-xs text-ink-faint leading-relaxed">
                Tus datos se usan únicamente para responderte. Sin listas, sin reenvíos.
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
         FOOTER
         ══════════════════════════════════════════════════════ -->
    <footer class="border-t border-line bg-surface">
      <div class="max-w-6xl mx-auto px-6 py-14">
        <div class="grid sm:grid-cols-2 gap-8 items-end">
          <div>
            <p class="font-display text-3xl font-bold text-ink leading-tight mb-2">
              Disponible para nuevos proyectos.
            </p>
            <a href="#contacto" class="link-draw text-sm font-semibold">Escribime →</a>
          </div>

          <div class="sm:text-right">
            <div class="flex sm:justify-end items-center gap-2 mb-4">
              <a
                href="https://www.linkedin.com/in/marcos-rezk"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn de Marcos Rezk"
                class="w-10 h-10 flex items-center justify-center border border-line text-ink-soft hover:text-on-pine hover:bg-pine hover:border-pine transition-colors"
              >
                <Icon name="linkedin" class="w-[18px] h-[18px]" />
              </a>
              <a
                href="https://github.com/mrezk84"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub de Marcos Rezk"
                class="w-10 h-10 flex items-center justify-center border border-line text-ink-soft hover:text-on-pine hover:bg-pine hover:border-pine transition-colors"
              >
                <Icon name="github" class="w-[18px] h-[18px]" />
              </a>
              <a
                href="mailto:mrezk84@gmail.com"
                aria-label="Enviar un correo a Marcos Rezk"
                class="w-10 h-10 flex items-center justify-center border border-line text-ink-soft hover:text-on-pine hover:bg-pine hover:border-pine transition-colors"
              >
                <Icon name="mail" class="w-[18px] h-[18px]" />
              </a>
            </div>
            <p class="label">
              © {new Date().getFullYear()} {name} · Montevideo, Uruguay
            </p>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <!-- Success / error dialog -->
  <div
    id="contact-modal"
    class="modal fixed inset-0 z-[100] flex items-center justify-center p-4"
    style="background: rgb(11 17 16 / 0.72); backdrop-filter: blur(6px);"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="modal__panel w-full max-w-md bg-surface border border-line" style="box-shadow: var(--shadow-lg);">
      <div class="flex items-center justify-between px-6 py-3 border-b border-line">
        <span id="modal-eyebrow" class="label label-pine">Enviado</span>
        <button id="modal-close-x" class="text-ink-faint hover:text-ink transition-colors" aria-label="Cerrar">
          <Icon name="close" class="w-4 h-4" strokeWidth={2} />
        </button>
      </div>

      <div class="p-8">
        <div id="modal-icon" class="w-12 h-12 flex items-center justify-center border border-pine text-pine mb-6">
          <Icon name="check" class="w-6 h-6" strokeWidth={2.5} />
        </div>

        <h3 id="modal-title" class="font-display text-2xl font-bold text-ink mb-3">Mensaje enviado</h3>
        <p id="modal-description" class="text-sm text-ink-soft leading-relaxed mb-7">
          Gracias por escribir. Recibí tu mensaje y te respondo a la brevedad.
        </p>

        <button id="modal-close-btn" class="btn btn-pine w-full">Entendido</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contacto form');
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
  const submitBtn = document.getElementById('submit-contact') as HTMLButtonElement | null;

  const modal = document.getElementById('contact-modal');
  const modalIcon = document.getElementById('modal-icon');
  const modalEyebrow = document.getElementById('modal-eyebrow');
  const modalTitle = document.getElementById('modal-title');
  const modalDescription = document.getElementById('modal-description');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalCloseX = document.getElementById('modal-close-x');

  /**
   * Strips markup-ish characters before the value is sent onward. This is a
   * courtesy filter for the inbox, not a security boundary — the real escaping
   * happens wherever the message is finally rendered.
   */
  function sanitize(value: string): string {
    return value
      .trim()
      .replace(/[<>]/g, '')
      .replace(/javascript:/gi, '')
      .replace(/on\w+=/gi, '')
      .slice(0, 5000);
  }

  const validators = {
    name: (v: string) => {
      const s = sanitize(v);
      return s.length >= 2 && s.length <= 100 && /^[\p{L}\s'’-]+$/u.test(s);
    },
    email: (v: string) => {
      const s = sanitize(v);
      return s.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s);
    },
    message: (v: string) => {
      const s = sanitize(v);
      return s.length >= 10 && s.length <= 5000;
    }
  };

  // Throttle: at most `maxAttempts` sends per rolling cooldown window. The
  // timestamps list is what makes this actually roll — the previous version
  // captured a single start time in a const, so the window never moved.
  const maxAttempts = 3;
  const cooldownPeriod = 60_000;
  let attemptTimestamps: number[] = [];

  function withinRateLimit(): boolean {
    const now = Date.now();
    attemptTimestamps = attemptTimestamps.filter((t) => now - t < cooldownPeriod);
    return attemptTimestamps.length < maxAttempts;
  }

  function setFieldState(
    input: HTMLInputElement | HTMLTextAreaElement,
    isValid: boolean,
    isDirty: boolean
  ) {
    const tip = document.getElementById(`${input.id}-tip`);
    input.classList.remove('is-valid', 'is-invalid');
    input.removeAttribute('aria-invalid');
    tip?.classList.remove('show');

    if (!isDirty) return;

    if (isValid) {
      input.classList.add('is-valid');
    } else {
      input.classList.add('is-invalid');
      input.setAttribute('aria-invalid', 'true');
      tip?.classList.add('show');
    }
  }

  ([
    [nameInput, validators.name],
    [emailInput, validators.email],
    [messageInput, validators.message]
  ] as const).forEach(([input, validate]) => {
    input?.addEventListener('input', () => {
      setFieldState(input, validate(input.value), input.value.length > 0);
    });
  });

  let lastFocused: HTMLElement | null = null;

  function openModal(isSuccess: boolean, message?: string) {
    if (!modal) return;
    lastFocused = document.activeElement as HTMLElement;

    if (modalIcon) {
      modalIcon.classList.toggle('border-pine', isSuccess);
      modalIcon.classList.toggle('text-pine', isSuccess);
      modalIcon.classList.toggle('border-signal', !isSuccess);
      modalIcon.classList.toggle('text-signal', !isSuccess);
    }
    if (modalEyebrow) {
      modalEyebrow.textContent = isSuccess ? 'Enviado' : 'Error';
      modalEyebrow.classList.toggle('label-pine', isSuccess);
      modalEyebrow.classList.toggle('label-signal', !isSuccess);
    }
    if (modalTitle) modalTitle.textContent = isSuccess ? 'Mensaje enviado' : 'No se pudo enviar';
    if (modalDescription) {
      modalDescription.textContent =
        message ??
        (isSuccess
          ? 'Gracias por escribir. Recibí tu mensaje y te respondo a la brevedad.'
          : 'Hubo un problema al enviar. Probá de nuevo o escribime por WhatsApp o email.');
    }

    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
    modalCloseBtn?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('show');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  modalCloseBtn?.addEventListener('click', closeModal);
  modalCloseX?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.classList.contains('show')) closeModal();
  });

  form?.addEventListener('submit', async (event) => {
    if (!form || !nameInput || !emailInput || !messageInput || !submitBtn) return;

    const isNameValid = validators.name(nameInput.value);
    const isEmailValid = validators.email(emailInput.value);
    const isMessageValid = validators.message(messageInput.value);

    setFieldState(nameInput, isNameValid, true);
    setFieldState(emailInput, isEmailValid, true);
    setFieldState(messageInput, isMessageValid, true);

    if (!isNameValid || !isEmailValid || !isMessageValid) {
      event.preventDefault();
      (!isNameValid ? nameInput : !isEmailValid ? emailInput : messageInput).focus();
      return;
    }

    // Without a Formspree endpoint the action is a mailto: — let the browser
    // hand off to the mail client instead of trying to fetch() it.
    if (form.dataset.live !== 'true') return;

    event.preventDefault();

    if (!withinRateLimit()) {
      openModal(false, 'Enviaste varios mensajes seguidos. Esperá un minuto antes de reintentar.');
      return;
    }
    attemptTimestamps.push(Date.now());

    nameInput.value = sanitize(nameInput.value);
    emailInput.value = sanitize(emailInput.value);
    messageInput.value = sanitize(messageInput.value);

    const originalBtnHTML = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.7';
    submitBtn.innerHTML =
      '<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
      '<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"/>' +
      '<path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>' +
      '</svg><span>Enviando…</span>';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      });

      if (response.ok) {
        openModal(true);
        form.reset();
        [nameInput, emailInput, messageInput].forEach((input) => setFieldState(input, false, false));
        // The attempt stays on the record deliberately: clearing it on success
        // would let an automated sender loop forever, since every one of its
        // posts succeeds. The window rolls off on its own after the cooldown.
      } else {
        let errorMsg: string | undefined;
        try {
          const data = await response.json();
          if (Array.isArray(data?.errors) && data.errors.length) {
            errorMsg = data.errors.map((e: { message?: string }) => e.message).filter(Boolean).join(', ');
          }
        } catch {
          /* non-JSON error body — fall back to the generic message */
        }
        openModal(false, errorMsg);
      }
    } catch {
      openModal(false);
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '';
      submitBtn.innerHTML = originalBtnHTML;
    }
  });
</script>
